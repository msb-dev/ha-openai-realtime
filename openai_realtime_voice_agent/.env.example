# Copy to .env and fill in. Required for the standalone compose deployment.
#
# OpenAI API key (required) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Home Assistant long-lived access token (required).
# Home Assistant → your profile → Security → Long-lived access tokens.
# The MCP server endpoint authenticates with this token.
LONGLIVED_TOKEN=

# Where Home Assistant's MCP server listens (required if not the default).
#   Home Assistant on the same host:      http://127.0.0.1:8123/api/mcp
#   Home Assistant elsewhere/bridged:     http://<ha-host>:8123/api/mcp
HA_MCP_URL=http://127.0.0.1:8123/api/mcp

# Port the agent's WebSocket listens on (the firmware's va_url must match).
WEBSOCKET_PORT=8080

# Optional overrides (defaults shown; see DOCS.md for everything else)
#OPENAI_MODEL=gpt-realtime-2
#OPENAI_VOICE=marin
#ENABLE_WEB_SEARCH=true
#TZ=UTC
